        },
        {
          "name": "keyword.other.block.swoftlang",
          "match": "\\b(look_at_players|projectile|arguments|next_slot|prev_slot|editable|paginate|particle|execute|fishing|refresh|border|column|manual|packet|render|source|async|catch|drops|first|lines|slots|state|grid|http|lore|slot)\\b(?!\\s*\\.)"
        },
        {
          "name": "keyword.other.connective.swoftlang",
          "match": "\\b(strength|subtitle|message|amount|chance|offset|toward|weight|count|away|code|from|into|stay|with|for|at|by|in|of|on|to)\\b"
