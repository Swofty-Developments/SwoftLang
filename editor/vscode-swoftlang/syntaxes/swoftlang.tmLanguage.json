      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.swoftlang",
          "match": "\\b(false|true)\\b"
        },
        {
          "name": "constant.language.swoftlang",
          "match": "\\b(none)\\b"
        },
        {
          "name": "constant.language.target.swoftlang",
          "match": "\\b(players|killer|sender|victim|self|all)\\b"
        }
      ]
