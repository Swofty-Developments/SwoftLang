      ]
    },
    "collection-ops": {
      "patterns": [
        {
          "comment": "collection ops: size/keys/values of m, m has k, sorted/reversed l, first/last of l",
          "name": "keyword.operator.collection.swoftlang",
          "match": "\\b(reversed|sorted|first|last|has|of)\\b"
        }
      ]
    },
    "keywords": {
