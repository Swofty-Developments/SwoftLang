(library
 (name swoftlang)
 (libraries yojson))

(ocamllex
 (modules lexer))

; phase-7: the Minestom event catalog is generated from data/events.json
; (source of truth) into data/events_data.ml by data/GenMinestomCatalogs.java;
; embed that registry fragment into the library at build time.
(rule
 (targets events_data.ml)
 (deps ../data/events_data.ml)
 (action
  (copy ../data/events_data.ml events_data.ml)))

; W-blocks: embed data/block_states.json (generated by data/GenBlockStates.java
; from the pinned Minestom jar) as an OCaml string constant so the compiler can
; validate block ids / property names / property values offline. The raw JSON is
; wrapped in a quoted string with a delimiter that cannot occur in the payload.
(rule
 (targets block_states_data.ml)
 (deps ../data/block_states.json)
 (action
  (with-stdout-to
   block_states_data.ml
   (progn
    (echo "let json = {swoftblocks|")
    (cat ../data/block_states.json)
    (echo "|swoftblocks}")))))

; Packet blocks: embed data/packets.json (generated by GenMinestomCatalogs.java
; from the pinned Minestom jar) as an OCaml string constant so the compiler can
; validate `Packet { on "Class" { } }` class names and type each packet's fields
; offline. Same delimiter-wrapping trick as the block states above.
(rule
 (targets packets_data.ml)
 (deps ../data/packets.json)
 (action
  (with-stdout-to
   packets_data.ml
   (progn
    (echo "let json = {swoftpackets|")
    (cat ../data/packets.json)
    (echo "|swoftpackets}")))))
